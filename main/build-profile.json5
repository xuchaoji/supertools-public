{
  "apiType": "stageMode",
  "buildOption": {
    "sourceOption": {
      "workers": [
        './src/main/ets/workers/CalcWorker.ets',
        './src/main/ets/workers/StressWorker.ets'
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "product",
      "source": {
        "sourceRoots": ['./src/product/'],
        "abilities": [
          {
            "name": "MainAbility",
            "icon": "$media:layered_icon",
            "label": "$string:MainAbility_label",
          }
        ]
      }
    },
    {
      "name": "dev",
      "source": {
        "sourceRoots": ['./src/dev/'],
        "abilities": [
          {
            "name": "MainAbility",
            "icon": "$media:layered_icon",
            "label": "$string:app_name_dev",
          }
        ]
      }
    }
  ]
}